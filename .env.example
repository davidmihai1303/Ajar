# Copy to .env and fill in. Never commit .env.
# Optional LLM (explanations/Q&A). Empty = built-in texts only.
# Local llama-server on the MSI (OpenAI-compatible): http://127.0.0.1:8080/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Seconds to wait for the LLM before showing the built-in text
LLM_TIMEOUT=60
# Scanner agent on the host (localhost only)
NETCHECK_AGENT_URL=http://127.0.0.1:8765
# Default UI language: ro | en
NETCHECK_LANG=ro
