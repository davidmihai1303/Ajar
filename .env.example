# Copy to .env and fill in. Never commit .env.
# Optional LLM (explanations/Q&A). Empty = built-in texts only.
# Local llama-server on the MSI (OpenAI-compatible): http://127.0.0.1:8080/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Seconds to wait for the LLM before showing the built-in text
LLM_TIMEOUT=60
# Scanner agent on the host (localhost only)
NETCHECK_AGENT_URL=http://127.0.0.1:8765
# Default UI language: ro | en
NETCHECK_LANG=ro
# LAN test mode, OFF by default. There is NO login: anyone on the same Wi-Fi can open the app.
# Use only on the team hotspot, never on a shared or venue network.
#   NETCHECK_BIND_HOST=0.0.0.0                              (listen on the network, not only 127.0.0.1)
#   NETCHECK_ALLOWED_HOSTS=raspberrypi.local,172.20.10.5   (names/IPs you type in the browser; no '*')
NETCHECK_BIND_HOST=127.0.0.1
NETCHECK_ALLOWED_HOSTS=
