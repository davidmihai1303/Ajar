# New-device check 5 minutes after boot, then every 10 minutes. For a demo:
#   sudo systemctl edit ajar-discover.timer   ->   [Timer] / OnUnitActiveSec= / OnUnitActiveSec=1min
[Unit]
Description=Run the Ajar new-device check every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
AccuracySec=30s
Unit=ajar-discover.service

[Install]
WantedBy=timers.target
